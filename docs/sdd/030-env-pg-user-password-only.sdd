SDD-TEXT 0.1

# Milton-spec #30: Agent .env is PG pass only (exactly PG_USER + PG_PASSWORD)
# Fields: hosts, agents, services, files, trigger, expected recovery, scenario flow
# Source: gwild/milton milton-specs.md hard rule 30 (Gregory, 2026-08-27; clarifies #5)
# Home: gwild/focus_agent. Milton is consumer.
# Author: Ivy (Red Team / InfoSec) — draft 0.1.1, 2026-10-26
# Link: docs/sdd/030-env-pg-user-password-only.sdd
#
# focus_agent rule status: **RULE** (SDD + fail-closed named Milton consumer gate).
# Same ladder as #5: L2 Milton consumer `scripts/check-env-hygiene.sh --check-allowlist`
#   enforces the exact two-key allowlist (database.principal_env + database.password_env;
#   today PG_USER + PG_PASSWORD), fail-closed, zero exceptions. Landed in gwild/milton#4760
#   (merge 13ec943d); wired via .githooks/pre-commit + scripts/mkpr.sh, start-agent seat gate
#   (`--check`), and specs-rules-gates CI fixture tests.
# Generalized focus_agent-native CI/xtask binding remains on focus_agent#1; this promotion does
# not wait on that wiring — same pattern as #5 / #28 / #32.

# ── MUST / FORBIDDEN (normative) ─────────────────────────────────────────────
# MUST: Agent .env contains exactly two keys: PG_USER and PG_PASSWORD.
# FORBIDDEN: Any third key name (including PG_HOST, PG_DATABASE, chat-token env, App keys).
# MUST: #5's "DB pass only" means these two keys and no others.
# MUST: Changing the allowlist requires Gregory to change this SDD and the hygiene gate in the SAME PR.
# MUST: Reviewers REJECT extra keys; gate MUST fail closed (no warning-only).

# ── Trigger scenario ─────────────────────────────────────────────────────────

Step J-001 "Author or provisioner touches agent .env"
  description="Someone adds, documents, or generates keys for a seat .env."
  actor=PR author / Provisioner
  intent="Keep the file usable for broker Postgres auth and nothing else"
  success_criteria="Only PG_USER and PG_PASSWORD are present; no third key"
  PRECEDES J-002 "Gate / review checks exact allowlist"
END

Step J-002 "Gate / review checks exact allowlist"
  description="Mechanical check and reviewer confirm the two-key contract from #5 made concrete."
  actor=Env hygiene gate / Reviewer
  intent="Reject any key that is not PG_USER or PG_PASSWORD"
  success_criteria="Fail closed on extra keys; CHANGES if docs or units inject more"
  PRECEDES J-003 "Invariant holds"
  REALIZED_BY PR-001 "Exact two-key allowlist"
END

Step J-003 "Invariant holds"
  description="Every live seat .env is exactly PG_USER + PG_PASSWORD."
  actor=System
  intent="Make #5 mechanically checkable"
  success_criteria="Named Milton consumer gate `scripts/check-env-hygiene.sh --check-allowlist` green (fail-closed); provisioner cannot emit other keys without co-changing this SDD and the gate"
END

# ── Processes ────────────────────────────────────────────────────────────────

Process PR-001 "Exact two-key allowlist"
  owner=Milton-consumer
  description="Keep deploy-agent / env writers and hygiene gates aligned with PG_USER + PG_PASSWORD only. Broader no-local-secrets intent remains under #5. Milton consumer `scripts/check-env-hygiene.sh --check-allowlist` (pre-commit / mkpr / start-agent; landed gwild/milton#4760) is the focus_agent RULE ladder; generalized focus_agent-native CI/xtask binding remains tracked on gwild/focus_agent#1."
  visibility=public
  DEPENDS_ON SA-001 "Two-key .env contract"
  DEPENDS_ON SA-002 "Env allowlist gate"
END

# ── System actions ───────────────────────────────────────────────────────────

SystemAction SA-001 "Two-key .env contract"
  owner=Milton-consumer
  description="Concrete allowlist clarifying milton-spec #5."
  system_name=agent-env
  action="MUST permit only PG_USER and PG_PASSWORD; MUST reject every other key name"
  failure_modes="(1) PG_HOST/PG_DATABASE added for convenience — FORBIDDEN (CHANGES; those are broker/bootstrap concerns, not .env secrets). (2) Chat-token or App keys — FORBIDDEN citing #5/#29/#30. (3) Warning-only hygiene — FORBIDDEN (CHANGES)."
END

SystemAction SA-002 "Env allowlist gate"
  owner=Milton-consumer
  description="#30 RULE ladder L2 (shared with #5): exact two-key allowlist check on the agent seat .env; allowed names are config-owned (database.principal_env / database.password_env), never inlined in the gate."
  system_name=milton:scripts/check-env-hygiene.sh --check-allowlist
  action="MUST fail on any third key, a missing or duplicated PG_USER / PG_PASSWORD, or world-accessible mode; MUST fail closed when the allowed names cannot be read"
  failure_modes="(1) Allowlist widened in the gate without this SDD changing in the SAME Gregory PR — FORBIDDEN. (2) Warning-only, marker, or env-var skip — FORBIDDEN (CHANGES). (3) Printing .env values in findings — FORBIDDEN."
END
