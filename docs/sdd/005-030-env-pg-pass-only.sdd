SDD-TEXT 0.1

# focus_agent policy SDD — Agent .env holds ONLY the DB pass
# Maps milton-specs #5 and #30 (exactly PG_USER + PG_PASSWORD; no other local secrets)
# Audience: generalized policy in focus_agent; Milton is a consumer implementation.
# Author: Ivy (Red Team / InfoSec) — draft 0.1, 2026-10-26
#
# Hosts: every agent seat host
# Agents: all fleet agents
# Services: deploy/provision that write .env; runtime that must not grow .env keys
# Files (Milton examples): deploy-agent.sh, _envload, check-env-hygiene (if present), seat .env
# Trigger: temptation to stash App keys, chat tokens, PEMs, provider secrets in .env or side files
# Expected behavior: .env has exactly two keys; every other secret is DB-resident and fetched JIT via broker

# ── Background ───────────────────────────────────────────────────────────────
#
# The agent .env exists solely so the local broker can authenticate to Postgres.
# Allowed keys: exactly PG_USER and PG_PASSWORD. Nothing else — not in .env,
# Downloads, /etc/... side stores, or repo backups. All other secrets live in
# the DB secret store and are read through broker typed ops at use time.
# A "missing" secret is a DB provisioning gap, never a reason to add a file
# fallback. Deprecated secrets outside the DB: capture into DB, then DELETE
# forever from the old location.

# ── Trigger scenario ─────────────────────────────────────────────────────────

Step J-001 "Seat needs a non-DB secret"
  description="Runtime needs an App key, provider secret, PEM, or similar"
  actor=AgentRuntime
  intent="Obtain the secret without growing local secret surface"
  success_criteria="Fetch via broker typed get_secret (or equivalent) into memory; never write to .env"
  PRECEDES J-002 "Provisioner writes .env"
END

Step J-002 "Provisioner writes agent .env"
  description="Deploy/provision creates or refreshes the seat .env"
  actor=Provisioner
  intent="Supply only the DB principal for this agent"
  success_criteria=".env contains exactly PG_USER and PG_PASSWORD; mode not world-readable"
  PRECEDES J-003 "Forbidden key appears"
  REALIZED_BY PR-001 "Env writer contract"
END

Step J-003 "Forbidden key or side-store secret appears"
  description="CHAT_TOKEN / App key / PEM / provider secret found in .env or a local side file"
  actor=Offender
  intent="Convenience stash or legacy leftover"
  success_criteria="Capture into DB if still needed; delete forever from disk; gate fails closed on reintroduction"
  PRECEDES J-004 "Invariant holds"
  REALIZED_BY PR-002 "Env hygiene enforcement"
END

Step J-004 "Invariant holds"
  description="Seats at rest show two-key .env; docs never instruct adding other keys"
  actor=System
  intent="Minimize local secret blast radius"
  success_criteria="Hygiene check green; missing secret → provisioning ticket, not file fallback"
END

# ── Processes ────────────────────────────────────────────────────────────────

Process PR-001 "Env writer contract"
  owner=Eng
  description="Deploy/provision writes only PG_USER + PG_PASSWORD into agent .env from DB lookup"
  visibility=backstage
  DEPENDS_ON SA-001 "Agent .env file"
END

Process PR-002 "Env hygiene enforcement"
  owner=Sec
  description="Checks refuse extra keys, .env backups in-repo, and file fallbacks for secrets"
  visibility=backstage
  DEPENDS_ON SA-002 "Secret fetch path"
END

# ── System actions ───────────────────────────────────────────────────────────

SystemAction SA-001 "Agent .env file"
  owner=Eng
  description="Per-seat .env consumed only by the local broker for Postgres auth"
  system_name="agent-env"
  action="Allowlist exactly PG_USER, PG_PASSWORD; restrictive file mode"
  failure_modes="(1) Extra keys 'for the bridge' → CHANGES. (2) .env.bak* in repo → refuse. (3) Docs teaching CHAT_TOKEN in .env → fix docs in same program of work."
END

SystemAction SA-002 "Secret fetch path"
  owner=Eng
  description="Broker typed ops for secret material (JIT into memory; no argv/log leakage)"
  system_name="broker-get-secret"
  action="Read secrets from DB secret store at use time; never cache to disk as default"
  failure_modes="(1) DB miss → fail loud / provision, never fall back to file. (2) Printing secret values in chat/logs → forbidden. (3) Shared OAuth files across seats → separate policy (#31); do not solve by stuffing into .env."
END
