SDD-TEXT 0.1

# Milton-spec #28: Secrets never in fuckyou.fuckyou / bootstrap yaml

# Source: gwild/milton milton-specs.md hard rule 28 (Gregory, 2026-08-27).
# Couples #26 bootstrap-only, #27 channels DB-only, #37 no new content-yaml. Home: gwild/focus_agent.
# Author: Ivy (Red Team / InfoSec) — draft 0.1, 2026-10-26

# ── Trigger scenario ─────────────────────────────────────────────────────────

Step J-001 "Operator or agent configures a secret"
  description="A secret must be associated with an agent or service."
  actor=Operator
  intent="Store the value where SOT lives"
  success_criteria="Value written to DB secret store via authorized set_secret path; yaml may name keys/structure only"
  PRECEDES J-002 "Loader reads bootstrap"
END

Step J-002 "Loader reads bootstrap"
  description="Daemon starts and reads bootstrap yaml once via the single allowed loader."
  actor=Loader
  intent="Bind ports/sockets/paths without learning secret values from yaml"
  success_criteria="No secret values parsed from yaml; live state comes from DB via broker afterward"
  PRECEDES J-003 "Secret value or new content-yaml appears"
  REALIZED_BY PR-001 "Bootstrap value ban"
END

Step J-003 "Secret value or new content-yaml appears"
  description="Token/password/PEM/bearer appears as a yaml value, or a new subsystem .yaml data store is added outside allowlist."
  actor=Offender
  intent="Convenience or training-gradient drift toward yaml"
  success_criteria="Fail closed at commit/review; move value to DB; delete yaml value; no silent accept"
  PRECEDES J-004 "Invariant holds"
  REALIZED_BY PR-002 "Content-yaml / secret-value gates"
END

Step J-004 "Invariant holds"
  description="Bootstrap remains structure-only; secrets only in DB; investigation never starts at yaml for seat truth."
  actor=System
  intent="Stop yaml-as-SOT regressions"
  success_criteria="Gates green; docs forbid secret values in yaml"
END

# ── Processes ────────────────────────────────────────────────────────────────

Process PR-001 "Bootstrap value ban"
  owner=Milton-consumer
  description="Single launch-time loader; bootstrap allowlist is structure-only; secret values forbidden."
  visibility=public
  DEPENDS_ON SA-001 "Bootstrap config file"
END

Process PR-002 "Content-yaml / secret-value gates"
  owner=Milton-consumer
  description="Pre-commit/CI refuse secret-like values in yaml and new content-yaml outside allowlist."
  visibility=public
  DEPENDS_ON SA-002 "Yaml policy gates"
END

# ── System actions ───────────────────────────────────────────────────────────

SystemAction SA-001 "Bootstrap config file"
  owner=Milton-consumer
  description="Structure-only config (Milton: fuckyou.fuckyou / CONFIG_FILE)."
  system_name=fuckyou.fuckyou
  action="May hold paths/ports/names; must not hold secret values; one read per process at launch."
  failure_modes="(1) Runtime re-read of yaml for decisions → regression. (2) Channels/secrets as yaml values → CHANGES. (3) Yaml-first investigation of agents → stop; use broker/DB first."
END

SystemAction SA-002 "Yaml policy gates"
  owner=Milton-consumer
  description="Mechanical checks for new content-yaml and secret-bearing yaml."
  system_name=scripts/check-no-new-content-yaml.py
  action="Fail closed; allowlist changes need Gregory approval on the same PR."
  failure_modes="(1) Static projected yaml carve-out without approval → reject. (2) Docs that show example secrets in yaml → fix. (3) Warning-only → CHANGES."
END
