SDD-TEXT 0.1

# Milton-spec #28: Secrets never in fuckyou.fuckyou / bootstrap yaml
# Fields: hosts, agents, services, files, trigger, expected recovery, scenario flow
# Source: gwild/milton milton-specs.md hard rule 28 (Gregory, 2026-08-27)
# Couples #26 bootstrap-only, #27 channels DB-only, #37 no new content-yaml.
# Home: gwild/focus_agent. Milton is consumer.
# Author: Ivy (Red Team / InfoSec) — draft 0.1.1, 2026-10-26
# Link: docs/sdd/028-no-secrets-in-yaml.sdd
#
# focus_agent rule status: **RULE** (SDD + fail-closed named Milton consumer gate).
# Ladder L2 Milton consumer for #28:
#   `scripts/check-specs-literal-bans.py` (credential-shaped literals + bootstrap secret-key values),
#   wired through pre-commit / mkpr / specs-rules-gates as that script is elsewhere.
# Coupled #37 surface `scripts/check-no-new-content-yaml.py` remains its own row until promoted.
# Generalized focus_agent-native CI/xtask binding remains on focus_agent#1 (Ivy co-owns security slice);
# this promotion does not wait on that wiring — same pattern as #32 / focus_agent#4.

# ── MUST / FORBIDDEN (normative) ─────────────────────────────────────────────
# MUST: Bootstrap / structure config holds names, paths, ports, schema names — never secret values.
# FORBIDDEN: Tokens, passwords, PEMs, bearer keys as yaml values.
# MUST: Channel assignments and secret values live in DB / secret store.
# FORBIDDEN: Treating yaml as live secret SOT or merging live mutable state from yaml.
# FORBIDDEN: New content-yaml for subsystem data outside an explicit allowlist approved by Gregory
#            on the same PR that changes the gate.
# MUST: Investigation / runtime decision order: broker → DB → runtime evidence → bootstrap LAST.
# MUST: Only the human operator (Gregory) path may set_secret. Agents MUST NOT write secret values
#       into yaml or bootstrap.
# MUST: Gates fail closed; reviewers REJECT secret-bearing yaml and unauthorized content-yaml.

# ── Trigger scenario ─────────────────────────────────────────────────────────

Step J-001 "Operator configures a secret"
  description="A secret must be associated with an agent or service."
  actor=Operator
  intent="Store the value where SOT lives"
  success_criteria="Value written to DB secret store via authorized set_secret path; yaml may name keys/structure only"
  PRECEDES J-002 "Loader reads bootstrap"
END

Step J-002 "Loader reads bootstrap"
  description="Daemon starts and reads bootstrap yaml once via the single allowed loader."
  actor=Loader
  intent="Bind ports/sockets/paths without learning secret values from yaml"
  success_criteria="No secret values parsed from yaml; live state comes from DB via broker afterward"
  PRECEDES J-003 "Secret value or new content-yaml appears"
  REALIZED_BY PR-001 "Bootstrap value ban"
END

Step J-003 "Secret value or new content-yaml appears"
  description="Token/password/PEM/bearer appears as a yaml value, or a new subsystem .yaml data store is added outside allowlist."
  actor=Offender
  intent="Convenience or training-gradient drift toward yaml"
  success_criteria="Fail closed at commit/review; move value to DB; delete yaml value; no silent accept"
  PRECEDES J-004 "Invariant holds"
  REALIZED_BY PR-002 "Content-yaml / secret-value gates"
END

Step J-004 "Invariant holds"
  description="Bootstrap remains structure-only; secrets only in DB; investigation never starts at yaml for seat truth."
  actor=System
  intent="Stop yaml-as-SOT regressions"
  success_criteria="Named Milton consumer gate `scripts/check-specs-literal-bans.py` green (fail-closed); no secret values in yaml; docs forbid secret values in yaml"
END

# ── Processes ────────────────────────────────────────────────────────────────

Process PR-001 "Bootstrap value ban"
  owner=Milton-consumer
  description="Single launch-time loader; bootstrap allowlist is structure-only; secret values forbidden."
  visibility=public
  DEPENDS_ON SA-001 "Bootstrap config file"
END

Process PR-002 "Content-yaml / secret-value gates"
  owner=Milton-consumer
  description="Pre-commit/CI refuse secret-like values in yaml and new content-yaml outside allowlist. Milton consumer `scripts/check-specs-literal-bans.py` (pre-commit / mkpr / specs-rules-gates, fail-closed) is the focus_agent RULE ladder for #28; coupled #37 `scripts/check-no-new-content-yaml.py` stays on its own row; generalized focus_agent-native CI/xtask binding remains tracked on gwild/focus_agent#1."
  visibility=public
  DEPENDS_ON SA-002 "Secret-literal ban gate"
  DEPENDS_ON SA-003 "Content-yaml gate (#37)"
END

# ── System actions ───────────────────────────────────────────────────────────

SystemAction SA-001 "Bootstrap config file"
  owner=Milton-consumer
  description="Structure-only config (Milton: fuckyou.fuckyou / CONFIG_FILE)."
  system_name=fuckyou.fuckyou
  action="MAY hold paths/ports/names; MUST NOT hold secret values; MUST one-read per process at launch"
  failure_modes="(1) Runtime re-read of yaml for decisions — FORBIDDEN. (2) Channels/secrets as yaml values — FORBIDDEN (CHANGES). (3) Yaml-first investigation of agents — FORBIDDEN; use broker/DB first."
END

SystemAction SA-002 "Secret-literal ban gate"
  owner=Milton-consumer
  description="#28 RULE ladder L2: mechanical check for credential-shaped literals and bootstrap secret-key values in yaml/bootstrap."
  system_name=milton:scripts/check-specs-literal-bans.py
  action="MUST fail closed (pre-commit / mkpr / specs-rules-gates); reject secret-bearing yaml values"
  failure_modes="(1) Docs that show example secrets in yaml — MUST fix. (2) Warning-only — FORBIDDEN (CHANGES). (3) Pre-existing secret-bearing values are open deletion work, never a pass."
END

SystemAction SA-003 "Content-yaml gate (#37)"
  owner=Milton-consumer
  description="Coupled #37 surface: mechanical check for new content-yaml outside allowlist. Tracked on its own INDEX row (#37, enforcer-deferred); not part of the #28 RULE promotion."
  system_name=milton:scripts/check-no-new-content-yaml.py
  action="MUST fail closed; allowlist changes need Gregory approval on the same PR"
  failure_modes="(1) Static projected yaml carve-out without approval — FORBIDDEN. (2) Warning-only — FORBIDDEN (CHANGES)."
END
