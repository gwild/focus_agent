SDD-TEXT 0.1

# focus_agent policy SDD: Converging transient breakage is not a blocker; post-merge followup requires a reviewed Deployment plan
# Source (verbatim severity preserved): milton-specs.md #20, #21
# Owner of this text: gwild/focus_agent. Milton (gwild/milton) is a CONSUMER only;
#   Milton paths below name the consumer gate that enforces this contract today.
# Intent fields use fail-loud / reject / stop semantics (never degrade, never continue silently).
# Ladder L1: this file.
# Ladder L2 (Milton consumer today): Milton consumer `scripts/check-pr-body.py` requires `### Deployment plan` or the explicit none form (#21). #20 is a reviewer constraint with no gate: L2 DEFERRED to focus_agent#1 (owner Elliot).
# Ladder L4: post-merge execution follows the approved plan verbatim after a single confirm.
# Link: docs/sdd/020-021-convergent-rollout-deployment-plan.sdd
#
# focus_agent rule status: SDD drafted; focus_agent executable enforcer DEFERRED (owner Elliot, focus_agent#1).
# The Milton gates named under Ladder L2 are consumer gates. Review is not a focus_agent RULE until a
# fail-closed CI/xtask gate exists in the focus_agent ladder. The contract itself is not deferred.

# ── Trigger scenario ─────────────────────────────────────────────────────────

Step J-001 "Trigger"
  description="A PR changes something whose merge needs post-merge action, or a reviewer considers blocking on a transient window."
  actor=Author / Reviewer
  intent="Gate rollout on a reviewed deterministic plan; block only non-converging breakage"
  success_criteria="PR body carries the plan; blocks cite only non-converging harm"
  PRECEDES J-002 "Failure: Blocking on converging breakage"
END

Step J-002 "Failure: Blocking on converging breakage"
  description="[#20] A correct change MUST NOT be blocked on transient breakage that converges (rolling restart windows bounded by fail-loud #16 and the breaker #19). A reviewer MAY block only non-converging breakage: data loss or corruption, a security hole, a crash-loop that does not self-heal, or a stuck fleet. A backward-compat alias is optional, never required."
  actor=Offending change, process, or agent
  intent="Reject the change or stop the process loudly; no fallback, no exemption marker, no silent continue"
  success_criteria="Reviewer blocks cite a non-converging harm or are withdrawn"
  PRECEDES J-003 "Failure: Improvised rollout"
  REALIZED_BY PR-001 "Detection"
END

Step J-003 "Failure: Improvised rollout"
  description="[#21] A merge that needs ANY post-merge action MUST carry a reviewed `### Deployment plan` with ordered deterministic steps and convergence verification; a PR with no followup states the none form explicitly. Improvising the rollout after merge is FORBIDDEN."
  actor=Offending change, process, or agent
  intent="Reject the change or stop the process loudly; no fallback, no exemption marker, no silent continue"
  success_criteria="Gate rejects a PR body without the plan section"
  PRECEDES J-004 "Recovery"
  REALIZED_BY PR-001 "Detection"
END

Step J-004 "Recovery"
  description="Add the plan and convergence check to the PR body; execute it in full on confirm."
  actor=Author
  intent="Deterministic, pre-approved rollout"
  success_criteria="Gate green; execution matches the plan"
  REALIZED_BY PR-002 "Recovery Action"
END

# ── Processes ────────────────────────────────────────────────────────────────

Process PR-001 "Detection"
  owner=focus_agent
  description="Mechanical gate or hook refuses the violating change or launch; the reviewer MUST reject anything the gate does not cover. Generalized focus_agent enforcer binding: DEFERRED to gwild/focus_agent#1 (owner Elliot); only the wiring is deferred, never this contract."
  visibility=backstage
  DEPENDS_ON SA-001 "PR body gate"
  DEPENDS_ON SA-002 "Reviewer constraint"
END

Process PR-002 "Recovery Action"
  owner=focus_agent
  description="Correct the root cause in the single source of truth; the failure stays visible until the correction lands."
  visibility=backstage
  DEPENDS_ON SA-001 "PR body gate"
END

# ── System actions ───────────────────────────────────────────────────────────

SystemAction SA-001 "PR body gate"
  owner=focus_agent
  description="PR body gate"
  system_name=milton:scripts/check-pr-body.py
  action="Require the Deployment plan section or its explicit none form"
  failure_modes="Placeholder plan rows are rejected."
END

SystemAction SA-002 "Reviewer constraint"
  owner=focus_agent
  description="Reviewer constraint"
  system_name=review + focus_agent#1
  action="Reviewers MUST NOT block on converging windows"
  failure_modes="Deferred wiring only."
END
