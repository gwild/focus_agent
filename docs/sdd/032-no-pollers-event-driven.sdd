SDD-TEXT 0.1

# Milton-spec #32: NO POLLERS — event-driven only (never revive a mechanism under replacement)
# Fields: hosts, agents, services, files, trigger, expected recovery, scenario flow
# Source: gwild/milton milton-specs.md hard rule 32 (Gregory, 2026-08-28; gate earned 2026-10-25)
# Home: gwild/focus_agent (generalized). Milton is consumer via check-no-pollers + CI.
# Link: docs/sdd/032-no-pollers-event-driven.sdd
#
# focus_agent rule status: RULE (fail-closed executable check exists in Milton consumer).
# Ladder: SDD (this file) + scripts/check-no-pollers.py + mkpr + specs-rules-gates CI.

# ── MUST / FORBIDDEN (normative) ─────────────────────────────────────────────
# MUST: New coordination SHALL be event-driven off an existing bus
#       (PostgreSQL LISTEN/NOTIFY — broker command_notify / chat NOTIFY — or GitHub App webhooks).
# FORBIDDEN: while-True sleep/poll loops; timer re-listers; crontab/watch -n; systemd .timer / On*Sec=;
#            threading.Timer / sched / schedule; Rust/JS sleep or interval for change detection;
#            ANY new timers.* catalog path; revival of a deleted timers.* key.
# FORBIDDEN: Restarting, re-enabling, or "temporarily" reviving a poller/mechanism under active
#            replacement (merged-or-open PR removing it). That revival is a REGRESSION.
# MUST: Zero exceptions on the gate — no exemption marker, no PR-body waiver, no warning tier.
# MUST: If a clock is genuinely required, Gregory changes this SDD and the gate in the SAME PR.

# ── Trigger scenario ─────────────────────────────────────────────────────────

Step J-001 "Trigger"
  description="Author needs change-detection / coordination (merge, chat, receipt, fleet flag) and reaches for sleep, poll, timer, cron, or a timed re-list instead of an existing event bus."
  actor=PR author
  intent="Ship coordination without burning shared-fleet CPU on poll loops"
  success_criteria="Design names PG LISTEN/NOTIFY, GitHub webhook, or another existing bus — or the approach is rejected"
  PRECEDES J-002 "Failure"
END

Step J-002 "Failure"
  description="A forbidden clock-wait / poll / timer catalog pattern lands, or a poller under active replacement is restarted."
  actor=PR / runtime
  intent="Surface the violation before merge or before revival ships"
  success_criteria="Gate or review fails closed citing milton-spec #32; no silent accept"
  PRECEDES J-003 "Recovery"
  REALIZED_BY PR-001 "Detection"
END

Step J-003 "Recovery"
  description="Replace the clock wait with an event consumer, or finish the in-flight replacement. NEVER revive the deprecated poller."
  actor=PR author / reviewer
  intent="Event-driven coordination only; migration never rolls backward"
  success_criteria="No poller pattern remains; check-no-pollers exits 0; replacement advanced or Gregory-authorized manual path used"
  REALIZED_BY PR-002 "Recovery Action"
END

# ── Processes (affected services / scripts) ───────────────────────────────────

Process PR-001 "Detection"
  owner=Milton-consumer
  description="scripts/check-no-pollers.py on pre-commit --staged, mkpr.sh, and specs-rules-gates CI. Fail-closed."
  visibility=backstage
  DEPENDS_ON SA-001 "Read State"
END

Process PR-002 "Recovery Action"
  owner=Milton-consumer
  description="Author rewrites to NOTIFY/webhook; reviewer REJECTS revival during migration; gate stays fail-closed."
  visibility=backstage
  DEPENDS_ON SA-002 "Write State"
END

# ── System actions (affected files / APIs) ────────────────────────────────────

SystemAction SA-001 "Read State"
  owner=Milton-consumer
  description="Gate scans staged/tree for poller and timer patterns, including revival of deleted timers.* keys."
  system_name=scripts/check-no-pollers.py
  action="MUST match forbidden clock-wait / re-list / timer catalog shapes; MUST exit non-zero with rule #32 text"
  failure_modes="Novel poll idiom escapes patterns — MUST extend the gate, NEVER waive. Mid-migration temporary restart of old poller — MUST reject as regression."
END

SystemAction SA-002 "Write State"
  owner=Milton-consumer
  description="Land event consumer / finish replacement; MUST NOT re-enable deprecated poller units or timers.* keys."
  system_name=broker NOTIFY + github_webhook + consumer code
  action="Wire LISTEN/NOTIFY or webhook path; remove sleep/poll loops; timers.* MUST NOT grow without Gregory+gate co-change"
  failure_modes="Replacement unfinished and author revives poller — FORBIDDEN. Gate and SDD diverge — MUST update both in one PR."
END
