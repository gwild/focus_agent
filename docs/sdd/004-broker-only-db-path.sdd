SDD-TEXT 0.1

# focus_agent policy SDD — Broker-only DB path
# Maps milton-specs #4 (Local per-agent DB-transport broker / LDB — the ONLY DB path)
# Audience: generalized policy in focus_agent; Milton is a consumer implementation.
# Author: Ivy (Red Team / InfoSec) — draft 0.1, 2026-10-26
#
# Hosts: every agent seat host
# Agents: all fleet agents and their co-located services
# Services: db-broker@<agent>, and every consumer that formerly opened Postgres directly
# Files (Milton consumer examples): scripts/db-broker.py, scripts/ldb*, scripts/ldb_client.py,
#        scripts/audit/check-db-connectors.py, .claude/hooks/enforce-mcp-chat.py
# Trigger: any code path that would open Postgres, run raw SQL, or read PG_* outside the broker
# Expected behavior: ONLY the local per-agent broker opens Postgres; all other actors use typed ops
#          over a per-agent unix socket; missing ops are added to the broker — never bypassed.

# ── Background ───────────────────────────────────────────────────────────────
#
# Live mutable state lives in the database (fleet_config / related tables). The
# ONLY process allowed to hold the agent DB pass and open Postgres is that
# agent's local broker (LDB), co-located on the agent's host. Agents, services,
# scripts, dashboards, launchers, provisioners, and tests are pure consumers of
# a fixed, closed, typed-op set. No raw SQL. No SSH-relay / central proxy /
# separate broker-pass (rejected forever). Ownership of a seat is broker
# presence (`whoami`), not a hostname field.
#
# Out of scope: which typed ops exist (expand the set with approval); schema
# design of fleet_config; human operator break-glass outside agent codepaths.

# ── Trigger scenario ─────────────────────────────────────────────────────────

Step J-001 "Consumer needs DB state"
  description="An agent, service, script, dashboard, test, or deploy tool needs to read or write live fleet state"
  actor=Consumer
  intent="Obtain or mutate DB-backed state without holding a DB pass"
  success_criteria="Call goes to the local broker typed-op API over the per-agent unix socket"
  PRECEDES J-002 "Broker executes"
END

Step J-002 "Broker is the only Postgres client"
  description="The local broker authenticates with the agent PG pass from .env and runs the typed op against Postgres"
  actor=LocalBroker
  intent="Consolidate all DB access behind one process and one credential"
  success_criteria="No other process on the host opens a Postgres connection for this agent"
  PRECEDES J-003 "Bypass attempt"
  REALIZED_BY PR-001 "Broker typed-op surface"
END

Step J-003 "Bypass attempt (direct driver / raw SQL / PG_* read)"
  description="Code tries import of a Postgres driver, raw SQL, connect(), or reading PG_* to reach the database outside the broker"
  actor=Offender
  intent="Shortcut for convenience or legacy pattern"
  success_criteria="Fail closed: mechanical gate/hook rejects; reviewer CHANGES; no exemption marker"
  PRECEDES J-004 "Invariant holds"
  REALIZED_BY PR-002 "Direct-DB ban enforcement"
END

Step J-004 "Invariant holds at rest and in review"
  description="Fleet code and new PRs contain no non-broker DB clients; missing capability becomes a new typed op, not a bypass"
  actor=System
  intent="Keep DB SOT reachable only through the broker forever"
  success_criteria="Audit/gate green; ownership checks use broker whoami, not hostname"
END

# ── Processes ────────────────────────────────────────────────────────────────

Process PR-001 "Broker typed-op surface"
  owner=Eng
  description="Per-agent local broker exposes a closed typed-op set over a unix socket; holds the only PG connection"
  visibility=backstage
  DEPENDS_ON SA-001 "Local broker process"
END

Process PR-002 "Direct-DB ban enforcement"
  owner=Sec
  description="Hooks/gates reject Postgres drivers, raw SQL, and PG_* reads outside the broker; reviewers reject new bypasses"
  visibility=backstage
  DEPENDS_ON SA-002 "Connector / driver audit gate"
END

# ── System actions ───────────────────────────────────────────────────────────

SystemAction SA-001 "Local broker process"
  owner=Eng
  description="db-broker@<agent> (or generalized equivalent) co-located with the agent seat"
  system_name="local-db-broker"
  action="Accept typed ops on per-agent socket; open Postgres with agent PG pass only"
  failure_modes="(1) Broker down → consumers fail loud, never open their own connection. (2) Wrong socket → permission/path error, not silent fallback to another agent. (3) Temptation to SSH-relay or centralize → REJECTED forever."
END

SystemAction SA-002 "Connector / driver audit gate"
  owner=Sec
  description="Mechanical ban on non-broker DB connectors (Milton: check-db-connectors / harness hooks)"
  system_name="db-connector-ban"
  action="Fail closed on direct driver/SQL/PG_* outside broker; zero exemptions"
  failure_modes="(1) Warning-only mode → treat as CHANGES. (2) Test helpers 'temporarily' connecting → same ban. (3) Dashboard/provisioner special cases → migrate to typed ops, delete direct connect."
END
