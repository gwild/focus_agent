SDD-TEXT 0.1

# Milton-spec #22: Reuse existing method — new function ids need Gregory + stable-id system

# Source: gwild/milton milton-specs.md hard rule 22 (Gregory, 2026-08-16).
# #33 is this rule made absolute for skills/hooks/scripts. Home: gwild/focus_agent.

# ── Trigger scenario ─────────────────────────────────────────────────────────

Step J-001 "Author needs a method, route, op, NOTIFY channel, or GUI object"
  description="Before implementing ANY method/function/route/op/NOTIFY-channel/GUI-object, search the codebase and specs for an existing one that already does it."
  actor=PR author
  intent="Extend the existing method instead of inventing a parallel path"
  success_criteria="Existing method found and reused, OR documented absence after search"
  PRECEDES J-002 "Request Gregory permission before minting a new id"
END

Step J-002 "Request Gregory permission before minting a new id"
  description="Registering ANY new function id — Op member, NOTIFY channel, route/endpoint, GUI object id, service/unit name — requires Gregory's EXPRESS permission FIRST."
  actor=PR author
  intent="No convenience minting of ids"
  success_criteria="Written Gregory approval before id lands, or work reuses an existing id"
  PRECEDES J-003 "Route through the stable-id system"
END

Step J-003 "Route through the stable-id system"
  description="Code references the stable id; the human-facing label is rendered ONLY where the operator (HIL) sees it. A rename moves the label/value, never the id (op-id/label contract, scripts/ldb_ops.py)."
  actor=PR author
  intent="Stable machine identity; labels can change without breaking references"
  success_criteria="New ids go through the id system; no hardcoded human labels as keys in code paths"
  PRECEDES J-004 "Reviewer rejects parallel paths and unapproved ids"
END

Step J-004 "Reviewer rejects parallel paths and unapproved ids"
  description="Building a parallel path when a method already exists is a REGRESSION (e.g. hand-rolled per-host SSH restart when restart-stack exists). Unapproved new ids are rejected."
  actor=Reviewer
  intent="Protect SSOT methods and the id contract"
  success_criteria="CHANGES_REQUESTED citing #22, or author switches to existing method / obtains approval"
END

# ── Processes ────────────────────────────────────────────────────────────────

Process PR-001 "Stable-id and reuse discipline"
  owner=Milton-consumer
  description="ldb_ops / Op catalog and related id registries remain the mint path. Skills/hooks/scripts reuse is further absolute under #33."
  visibility=public
  DEPENDS_ON SA-001 "ldb_ops id contract"
END

# ── System actions ───────────────────────────────────────────────────────────

SystemAction SA-001 "ldb_ops id contract"
  owner=Milton-consumer
  description="Stable ids in code; labels for HIL only. Rename label without changing id."
  system_name=scripts/ldb_ops.py
  action="Reject PRs that mint routes/channels/ops/GUI ids without Gregory approval or that duplicate existing restart/deploy/chat methods."
  failure_modes="(1) while-Im-here second implementation — reject. (2) Label used as key — force stable id."
END
